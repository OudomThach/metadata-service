# Metadata Service configuration
# Copy to .env and adjust.

# Postgres (compose service metadata-postgres)
METADATA_DB_PASSWORD=metadata
METADATA_DB_PORT=5433

# API port exposed by the metadata-service container
METADATA_PORT=8095

# Comma-separated API keys = the team passwords for portal login AND for API
# consumers (sent as X-API-Key). EMPTY = open access (dev only).
# Note: POST /api/v1/records stays open by design (extraction hook).
METADATA_API_KEYS=

# Comma-separated CORS origins (e.g. https://portal.example.com).
# Leave empty when the portal is served same-origin.
METADATA_CORS_ORIGINS=
